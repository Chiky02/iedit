# Prisma Postgres (Vercel Marketplace)
# Storage → Prisma Postgres → Connect, o consola de Prisma → Connect.

# Pooled — la usa la app en runtime. Vercel suele inyectar esta sola.
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"

# Direct — migraciones, seed y Prisma Studio. Cópiala del panel de Prisma.
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Autenticación (genera uno propio, no reutilices este valor)
AUTH_SECRET="cambia-este-secreto"
